{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inzh work calendar",
  "version": "0.2.2",
  "identifier": "com.inzh.workcalendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "inzh's work calendar",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#141311"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMkMyQUNGODdCMkE2NTMKUldSVHByS0h6eW9zY1dWd2ozLzNXVWRsdG8rQzBwMG9pOHBRS2x0VENCcEZ2OEtFMFBCQ3cySmQK",
      "endpoints": [
        "https://github.com/NeyroslopInzh/inzh-work-calendar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
